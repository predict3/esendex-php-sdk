<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="build/.phpunit.cache">
    <testsuites>
        <testsuite name="Esendex">
            <directory suffix="Test.php">test</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Safety net: any real HTTP call goes to a dead proxy and fails. No SMS can ever leave from the test suite. -->
        <env name="http_proxy" value="http://127.0.0.1:9" force="true"/>
        <env name="https_proxy" value="http://127.0.0.1:9" force="true"/>
        <env name="HTTP_PROXY" value="http://127.0.0.1:9" force="true"/>
        <env name="HTTPS_PROXY" value="http://127.0.0.1:9" force="true"/>
        <env name="ALL_PROXY" value="http://127.0.0.1:9" force="true"/>
        <env name="all_proxy" value="http://127.0.0.1:9" force="true"/>
        <env name="no_proxy" value="" force="true"/>
        <env name="NO_PROXY" value="" force="true"/>
    </php>
</phpunit>
